{
  "title": "Gateway k8s Observability Lab",
  "uid": "gw-k8s-lab",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "config reloads",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "expr": "changes(gw_config_reloads_total{result=\"success\"}[1m]) > 0",
        "titleFormat": "config reload"
      }
    ]
  },
  "panels": [
    {
      "id": 9,
      "title": "Build info",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "gw_build_info",
          "legendFormat": "{{version}} / {{go_version}}"
        }
      ]
    },
    {
      "id": 1,
      "title": "Request rate by route/code",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (route, code) (rate(gw_requests_total[1m]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50/p95/p99 per route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(gw_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gw_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(gw_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error ratio by source",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(gw_requests_total{reason!=\"none\"}[1m])) / sum (rate(gw_requests_total[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Request rate by pod",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(gw_requests_total[1m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "In-flight by pod",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (pod) (gw_in_flight_requests)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests per upstream",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "gw_in_flight_requests",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Unmatched traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(gw_requests_total{route=\"__unmatched__\"}[1m]))",
          "legendFormat": "unmatched req/s"
        },
        {
          "expr": "gw_unmatched_unique_paths",
          "legendFormat": "distinct unmatched paths"
        }
      ]
    },
    {
      "id": 8,
      "title": "Sink drops and queue depth",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (sink, reason) (rate(gw_sink_dropped_total[1m]))",
          "legendFormat": "{{sink}} dropped ({{reason}})"
        },
        {
          "expr": "gw_sink_queue_depth",
          "legendFormat": "{{sink}} queue depth"
        }
      ]
    }
  ]
}
